{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrormii.ai/contracts/genii-persona/library.schema.json",
  "title": "Result copy library (library.json)",
  "description": "research/persona-quiz-v2/final/library.json: the six axes, the 16 archetype halves, the 50 tags in 25 pairs, rooms, insights and every result line in both voices. Everything is keyed by id, so names and lines can be rewritten without touching evidence (LAUNCH-SPEC sections 7, 21 and 22). Fields under `h` are the Heart to heart voice. zh fields are Sally's source text, kept for reference only.",
  "type": "object",
  "required": ["version", "built", "axes", "relationship", "life", "flex", "unfinished", "tags", "insights", "insightFallback", "rooms"],
  "properties": {
    "version": { "const": "persona-quiz-v2" },
    "built": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sources": { "type": "array" },
    "axes": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/axis" } },
    "relationship": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/half" } },
    "life": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/half" } },
    "typeNameRule": { "type": "string" },
    "typeCodeRule": { "type": "string" },
    "flex": {
      "type": "object",
      "required": ["badge", "line"],
      "properties": { "badge": { "type": "string" }, "line": { "type": "string" }, "zh": { "type": "string" }, "h": { "type": "object" } }
    },
    "unfinished": {
      "type": "object",
      "required": ["line"],
      "properties": { "line": { "type": "string" }, "zh": { "type": "string" }, "h": { "type": "object" } }
    },
    "examples": { "type": "array", "items": { "type": "string" } },
    "insights": {
      "type": "object",
      "description": "The thing you didn't know: per axis, a line for a believe-versus-did split, by the side the player believes.",
      "required": ["R1", "R2", "R3", "L1", "L2", "L3"],
      "additionalProperties": false,
      "patternProperties": {
        "^[RL][1-3]$": {
          "type": "object",
          "required": ["believePlus", "believeMinus"],
          "additionalProperties": false,
          "properties": { "believePlus": { "$ref": "#/$defs/voicePair" }, "believeMinus": { "$ref": "#/$defs/voicePair" } }
        }
      }
    },
    "insightFallback": {
      "type": "object",
      "description": "Per half code: the insight when no split exists.",
      "minProperties": 16,
      "propertyNames": { "$ref": "#/$defs/halfCode" },
      "additionalProperties": { "$ref": "#/$defs/voicePair" }
    },
    "tagRules": { "type": "object" },
    "tagChapters": { "type": "object", "additionalProperties": { "type": "string" } },
    "tags": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/tag" } },
    "rooms": {
      "type": "object",
      "description": "Room by room: per chapter, a name and one line per axis end the room can show (plus or minus), both voices.",
      "propertyNames": { "pattern": "^[1-7]$" },
      "additionalProperties": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 }, "h": { "type": "object" } },
        "patternProperties": {
          "^[RL][1-3]$": {
            "type": "object",
            "required": ["plus", "minus"],
            "additionalProperties": false,
            "properties": {
              "plus": { "type": "string", "minLength": 1 },
              "minus": { "type": "string", "minLength": 1 },
              "h": { "type": "object", "required": ["plus", "minus"], "additionalProperties": false, "properties": { "plus": { "type": "string" }, "minus": { "type": "string" } } }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "roomsRule": { "type": "string" },
    "sheetRule": { "type": "string" },
    "articleRule": { "type": "string" },
    "article": {
      "type": "object",
      "description": "Evidence Article frames (LAUNCH-SPEC section 25 item 3): section titles and connective copy, each leaf a { fun, heart } pair. Frames carry no claim about the player; claims come from the lines above, picked by evidence."
    },
    "crossover": {
      "type": "object",
      "description": "Evidence Article: a people stat end crossed with a life stat end (key 'R1+|L2-'), typed team or clash, both voices.",
      "propertyNames": { "pattern": "^R[1-3][+-]\\|L[1-3][+-]$" },
      "additionalProperties": {
        "type": "object",
        "required": ["type", "fun", "heart"],
        "additionalProperties": false,
        "properties": { "type": { "enum": ["team", "clash"] }, "fun": { "type": "string", "minLength": 1 }, "heart": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "pole": { "enum": ["We", "Me", "Direct", "Soft", "Classic", "Own", "Steady", "Venture", "Push", "Easy", "Rules", "Context"] },
    "halfCode": { "type": "string", "pattern": "^((We|Me)·(Direct|Soft)·(Classic|Own)|(Steady|Venture)·(Push|Easy)·(Rules|Context))$" },
    "voicePair": {
      "type": "object",
      "required": ["fun", "heart"],
      "additionalProperties": false,
      "properties": { "fun": { "type": "string", "minLength": 1 }, "heart": { "type": "string", "minLength": 1 } }
    },
    "bands": {
      "type": "object",
      "required": ["light", "clear", "strong"],
      "additionalProperties": false,
      "properties": { "light": { "type": "string" }, "clear": { "type": "string" }, "strong": { "type": "string" } }
    },
    "sheet": {
      "type": "object",
      "description": "Character sheet line per end and band (light 1 to 2 pips, clear 3, strong 4 to 5), plus the near-even line.",
      "required": ["plus", "minus", "both"],
      "additionalProperties": false,
      "properties": { "plus": { "$ref": "#/$defs/bands" }, "minus": { "$ref": "#/$defs/bands" }, "both": { "type": "string" } }
    },
    "axis": {
      "type": "object",
      "required": ["id", "plus", "minus", "plusLine", "minusLine", "plusKnow", "minusKnow", "flexKnow", "plusKeyword", "minusKeyword", "sheet", "h"],
      "properties": {
        "id": { "enum": ["R1", "R2", "R3", "L1", "L2", "L3"] },
        "plus": { "$ref": "#/$defs/pole" },
        "minus": { "$ref": "#/$defs/pole" },
        "zhPlus": { "type": "string" },
        "zhMinus": { "type": "string" },
        "topic": { "type": "string" },
        "plusLine": { "type": "string" },
        "minusLine": { "type": "string" },
        "plusKnow": { "type": "string" },
        "minusKnow": { "type": "string" },
        "flexKnow": { "type": "string" },
        "plusKeyword": { "type": "string", "minLength": 1 },
        "minusKeyword": { "type": "string", "minLength": 1 },
        "sheet": { "$ref": "#/$defs/sheet" },
        "h": {
          "type": "object",
          "required": ["plusLine", "minusLine", "plusKnow", "minusKnow", "flexKnow", "sheet"],
          "properties": {
            "plusLine": { "type": "string" }, "minusLine": { "type": "string" }, "plusKnow": { "type": "string" }, "minusKnow": { "type": "string" }, "flexKnow": { "type": "string" },
            "sheet": { "$ref": "#/$defs/sheet" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "half": {
      "type": "object",
      "description": "One archetype half (8 people archetypes, 8 life archetypes). Code is the internal id, never shown.",
      "required": ["code", "name", "desc", "read", "sting", "heart", "h"],
      "properties": {
        "code": { "$ref": "#/$defs/halfCode" },
        "R1": { "enum": [1, -1] }, "R2": { "enum": [1, -1] }, "R3": { "enum": [1, -1] },
        "L1": { "enum": [1, -1] }, "L2": { "enum": [1, -1] }, "L3": { "enum": [1, -1] },
        "name": { "type": "string", "minLength": 1 },
        "zh": { "type": "string" },
        "desc": { "type": "string" },
        "read": { "type": "string" },
        "sting": { "type": "string" },
        "heart": { "type": "string" },
        "h": {
          "type": "object",
          "required": ["desc", "read", "sting", "heart"],
          "additionalProperties": false,
          "properties": { "desc": { "type": "string" }, "read": { "type": "string" }, "sting": { "type": "string" }, "heart": { "type": "string" } }
        }
      },
      "additionalProperties": false
    },
    "tag": {
      "type": "object",
      "required": ["id", "pair", "chapter", "name", "line", "sting", "heart", "calls", "h", "locked18", "friendGame", "keyword"],
      "properties": {
        "id": { "type": "string", "pattern": "^T\\d{2}[AB]$" },
        "pair": { "type": "string", "pattern": "^T\\d{2}[AB]$" },
        "chapter": { "type": "integer", "minimum": 1, "maximum": 7 },
        "name": { "type": "string", "minLength": 1, "description": "Plain tag name, 4 words or fewer." },
        "line": { "type": "string", "minLength": 1 },
        "sting": { "type": "string", "minLength": 1 },
        "heart": { "type": "string", "minLength": 1 },
        "calls": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "keyword": { "type": "string", "minLength": 1, "description": "Core-trait keyword (one or two words)." },
        "echo": { "type": "string", "pattern": "^[RL][1-3]:(plus|minus)$", "description": "The stat end this tag restates; that end's keyword is then left out of the core traits." },
        "locked18": { "type": "boolean", "description": "Marriage and kids tags: never on anything shareable, off by default in the friend game." },
        "loveTag": { "type": "boolean" },
        "friendGame": { "enum": ["open", "defaultOff"] },
        "h": {
          "type": "object",
          "required": ["line", "sting", "heart"],
          "additionalProperties": false,
          "properties": { "line": { "type": "string" }, "sting": { "type": "string" }, "heart": { "type": "string" } }
        },
        "zh": { "type": "string" },
        "never": { "type": "string" },
        "triggers": { "type": "array" },
        "origin": { "type": "string" },
        "zhStatus": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
